# Is file ko copy karke .env banao aur apni values bharo. .env kabhi git par mat dalo.
GEMINI_API_KEY=your-gemini-key-here
# Customer links ke tokens (comma se alag). Lambi random values rakho.
CLIENT_TOKENS=client-token-one,client-token-two
# Sales reps ki key (lambi random value)
ADMIN_API_KEY=change-me-long-random
# Database file ki jagah
DB_PATH=trade_desk.db
# Rate limit aur daily cost cap (model calls)
RATE_LIMIT_PER_MIN=10
DAILY_LLM_CALLS=300
